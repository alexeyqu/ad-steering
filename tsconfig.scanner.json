{
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "target": "ES2020",
    "outDir": "./dist-scanner",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/lib/**/*.ts", "src/scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
